{
  "manifest_version": 3,
  "name": "sjegink's Youtube Video Utilities",
  "description": "__MSG_extension_description__",
  "default_locale": "en",
  "version": "1.0",
  "icons": {
    "16": "assets/youtube_repeat.png",
    "48": "assets/youtube_repeat.png",
    "128": "assets/youtube_repeat.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/watch*"],
      "js": ["lib/content_youtube.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "permissions": [
  ]
}